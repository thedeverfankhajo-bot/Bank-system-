{
  "name": "thedeverfankhajo-bot/bank-system",
  "description": "Standalone PocketMine-MP API 5 banking plugin with SQLite persistence",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-sqlite3": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "BankSystem\\": "src/BankSystem/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BankSystem\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
